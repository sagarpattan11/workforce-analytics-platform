{
  "name": "wfa-backend",
  "version": "1.0.0",
  "description": "Workforce Analytics Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
